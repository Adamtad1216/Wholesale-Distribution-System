}


model Delivery {
  id             String   @id @default(uuid()) @db.Uuid
  deliveryNumber String   @unique @map("delivery_number")
  salesOrderId   String   @map("sales_order_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  driverId       String   @map("driver_id") @db.Uuid
  vehicleId      String   @map("vehicle_id") @db.Uuid
  scheduledDate  DateTime @map("scheduled_date")
  deliveryDate   DateTime? @map("delivery_date")
  status         String   @default("SCHEDULED")
  deliveryAddress String  @map("delivery_address")
  notes          String?
  createdById    String?  @map("created_by_id") @db.Uuid
  updatedById    String?  @map("updated_by_id") @db.Uuid

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  customer   Customer   @relation(fields: [customerId], references: [id])
  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id])
  driver     Driver     @relation(fields: [driverId], references: [id])
  vehicle    Vehicle    @relation(fields: [vehicleId], references: [id])
  createdBy  User?      @relation("DeliveryCreator", fields: [createdById], references: [id])
  updatedBy  User?      @relation("DeliveryUpdater", fields: [updatedById], references: [id])

  items DeliveryItem[]
  proofs DeliveryProof[]

  @@index([salesOrderId])
  @@index([customerId])
  @@index([warehouseId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([scheduledDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("deliveries")
}


model DeliveryItem {
  id               String  @id @default(uuid()) @db.Uuid
  deliveryId       String  @map("delivery_id") @db.Uuid
  salesOrderItemId String  @map("sales_order_item_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  quantity         Decimal @db.Decimal(15, 3)
  deliveredQuantity Decimal @default(0) @map("delivered_quantity") @db.Decimal(15, 3)
  returnedQuantity Decimal @default(0) @map("returned_quantity") @db.Decimal(15, 3)
  createdById      String? @map("created_by_id") @db.Uuid
  updatedById      String? @map("updated_by_id") @db.Uuid

  delivery      Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  createdBy     User?         @relation("DeliveryItemCreator", fields: [createdById], references: [id])
  updatedBy     User?         @relation("DeliveryItemUpdater", fields: [updatedById], references: [id])

  @@index([deliveryId])
  @@index([salesOrderItemId])
  @@index([productId])
  @@index([createdById])
  @@index([updatedById])
  @@map("delivery_items")
}


model DeliveryProof {
  id               String   @id @default(uuid()) @db.Uuid
  deliveryId       String   @map("delivery_id") @db.Uuid
  proofType        String   @map("proof_type")
  fileUrl          String?  @map("file_url")
  recipientName    String?  @map("recipient_name")
  recipientSignature String? @map("recipient_signature")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  createdById      String?  @map("created_by_id") @db.Uuid
  updatedById      String?  @map("updated_by_id") @db.Uuid

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("DeliveryProofCreator", fields: [createdById], references: [id])
  updatedBy User?   @relation("DeliveryProofUpdater", fields: [updatedById], references: [id])

  @@index([deliveryId])
  @@index([createdById])
  @@index([updatedById])
  @@map("delivery_proofs")
}


// ============================================================
// 08. FINANCE & PAYMENTS
// ============================================================

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceNumber String   @unique @map("invoice_number")
  customerId    String   @map("customer_id") @db.Uuid
  salesOrderId  String   @map("sales_order_id") @db.Uuid
  invoiceDate   DateTime @map("invoice_date")
  dueDate       DateTime @map("due_date")
  subtotal      Decimal  @default(0) @db.Decimal(15, 2)
  discount      Decimal  @default(0) @db.Decimal(15, 2)
  tax           Decimal  @default(0) @db.Decimal(15, 2)
  total         Decimal  @default(0) @db.Decimal(15, 2)
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(15, 2)
  balance       Decimal  @default(0) @db.Decimal(15, 2)
  status        String   @default("UNPAID")
  createdById   String?  @map("created_by_id") @db.Uuid
  updatedById   String?  @map("updated_by_id") @db.Uuid

  customer  Customer   @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  createdBy User?      @relation("InvoiceCreator", fields: [createdById], references: [id])
  updatedBy User?      @relation("InvoiceUpdater", fields: [updatedById], references: [id])

  items InvoiceItem[]
  paymentAllocations PaymentAllocation[]

  @@index([customerId])
  @@index([salesOrderId])
  @@index([dueDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("invoices")
}


model InvoiceItem {
  id         String  @id @default(uuid()) @db.Uuid
  invoiceId  String  @map("invoice_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Decimal @db.Decimal(15, 3)
  unitPrice  Decimal @map("unit_price") @db.Decimal(15, 2)
  discount   Decimal @default(0) @db.Decimal(15, 2)
  tax        Decimal @default(0) @db.Decimal(15, 2)
  total      Decimal @db.Decimal(15, 2)
  createdById String? @map("created_by_id") @db.Uuid
  updatedById String? @map("updated_by_id") @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  createdBy User? @relation("InvoiceItemCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("InvoiceItemUpdater", fields: [updatedById], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([createdById])
  @@index([updatedById])
  @@map("invoice_items")
}


model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  paymentNumber   String        @unique @map("payment_number")
  customerId      String?       @map("customer_id") @db.Uuid
  supplierId      String?       @map("supplier_id") @db.Uuid
  paymentType     PaymentType   @map("payment_type")
  paymentMethod   PaymentMethod @map("payment_method")
  amount          Decimal       @db.Decimal(15, 2)
  paymentDate     DateTime      @map("payment_date")
  referenceNumber String?       @map("reference_number")
  status          String        @default("COMPLETED")
  receivedBy      String?       @map("received_by") @db.Uuid
  updatedById     String?       @map("updated_by_id") @db.Uuid

  customer Customer? @relation(fields: [customerId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  receiver User?     @relation(fields: [receivedBy], references: [id])
  updatedBy User?    @relation("PaymentUpdater", fields: [updatedById], references: [id])

  allocations PaymentAllocation[]
  refunds     Refund[]

  @@index([customerId])
  @@index([supplierId])
  @@index([paymentDate])
  @@index([receivedBy])
  @@index([updatedById])
  @@map("payments")
}


model PaymentAllocation {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  amount      Decimal  @db.Decimal(15, 2)
  allocatedAt DateTime @default(now()) @map("allocated_at")
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  createdBy User?  @relation("PaymentAllocationCreator", fields: [createdById], references: [id])
  updatedBy User?  @relation("PaymentAllocationUpdater", fields: [updatedById], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@index([createdById])
  @@index([updatedById])
  @@map("payment_allocations")
}


model Refund {
  id           String   @id @default(uuid()) @db.Uuid
  refundNumber String   @unique @map("refund_number")
  paymentId    String   @map("payment_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  amount       Decimal  @db.Decimal(15, 2)
  reason       String
  refundDate   DateTime @map("refund_date")
  status       String   @default("PENDING")
  processedBy  String   @map("processed_by") @db.Uuid
  updatedById  String?  @map("updated_by_id") @db.Uuid

  payment    Payment  @relation(fields: [paymentId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  processor  User     @relation(fields: [processedBy], references: [id])
  updatedBy  User?    @relation("RefundUpdater", fields: [updatedById], references: [id])

  @@index([paymentId])
  @@index([customerId])
  @@index([processedBy])
  @@index([updatedById])
  @@map("refunds")
}


model Credit {
  id            String   @id @default(uuid()) @db.Uuid
  creditNumber  String   @unique @map("credit_number")
  customerId    String   @map("customer_id") @db.Uuid
  salesReturnId String?  @map("sales_return_id") @db.Uuid
  amount        Decimal  @db.Decimal(15, 2)
  reason        String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) @map("created_at")
  createdById   String?  @map("created_by_id") @db.Uuid
  updatedById   String?  @map("updated_by_id") @db.Uuid

  customer   Customer    @relation(fields: [customerId], references: [id])
  salesReturn SalesReturn? @relation(fields: [salesReturnId], references: [id])
  createdBy  User?        @relation("CreditCreator", fields: [createdById], references: [id])
  updatedBy  User?        @relation("CreditUpdater", fields: [updatedById], references: [id])

  @@index([customerId])
  @@index([salesReturnId])
  @@index([createdById])
  @@index([updatedById])
  @@map("credits")
}


// ============================================================
// 09. AI, NOTIFICATIONS & AUDIT
// ============================================================

model AiQuery {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  question  String
  intent    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedById String? @map("updated_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])
  updatedBy User? @relation("AiQueryUpdater", fields: [updatedById], references: [id])

  recommendations AiRecommendation[]

  @@index([userId])
  @@index([createdAt])
  @@index([updatedById])
  @@map("ai_queries")
}


model AiRecommendation {
  id               String  @id @default(uuid()) @db.Uuid
  aiQueryId        String  @map("ai_query_id") @db.Uuid
  recommendationType String @map("recommendation_type")
  title            String
  description      String
  confidenceScore  Decimal? @map("confidence_score") @db.Decimal(5, 4)
  createdAt        DateTime @default(now()) @map("created_at")
  createdById      String?  @map("created_by_id") @db.Uuid
  updatedById      String?  @map("updated_by_id") @db.Uuid

  aiQuery AiQuery @relation(fields: [aiQueryId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("AiRecommendationCreator", fields: [createdById], references: [id])
  updatedBy User?           @relation("AiRecommendationUpdater", fields: [updatedById], references: [id])

  sources AiRecommendationSource[]

  @@index([aiQueryId])
  @@index([createdById])
  @@index([updatedById])
  @@map("ai_recommendations")
}


model AiRecommendationSource {
  id             String  @id @default(uuid()) @db.Uuid
  recommendationId String @map("recommendation_id") @db.Uuid
  sourceType     String  @map("source_type")
  sourceId       String  @map("source_id") @db.Uuid
  metricName     String? @map("metric_name")
  metricValue    Decimal? @map("metric_value") @db.Decimal(15, 4)
  explanation    String?
  createdById    String? @map("created_by_id") @db.Uuid
  updatedById    String? @map("updated_by_id") @db.Uuid

  recommendation AiRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  createdBy      User?            @relation("AiRecommendationSourceCreator", fields: [createdById], references: [id])
  updatedBy      User?            @relation("AiRecommendationSourceUpdater", fields: [updatedById], references: [id])

  @@index([recommendationId])
  @@index([sourceType, sourceId])
  @@index([createdById])
  @@index([updatedById])
  @@map("ai_recommendation_sources")
}


model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  message   String
  type      String
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")
  updatedById String? @map("updated_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("NotificationUpdater", fields: [updatedById], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([updatedById])
  @@map("notifications")
}


model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedById String? @map("updated_by_id") @db.Uuid

  user User? @relation(fields: [userId], references: [id])
  updatedBy User? @relation("AuditLogUpdater", fields: [updatedById], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([updatedById])
  @@map("audit_logs")
}
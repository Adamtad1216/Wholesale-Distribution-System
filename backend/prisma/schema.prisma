model Invoice {
  id                 String              @id @default(uuid()) @db.Uuid
  createdById        String?             @map("created_by_id") @db.Uuid
  updatedById        String?             @map("updated_by_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  isArchived         Boolean             @default(false) @map("is_archived")
  archivedAt         DateTime?           @map("archived_at")
  invoiceNumber      String              @unique @map("invoice_number")
  customerId         String              @map("customer_id") @db.Uuid
  salesOrderId       String              @map("sales_order_id") @db.Uuid
  invoiceDate        DateTime            @map("invoice_date")
  dueDate            DateTime            @map("due_date")
  subtotal           Decimal             @default(0) @db.Decimal(15, 2)
  discount           Decimal             @default(0) @db.Decimal(15, 2)
  tax                Decimal             @default(0) @db.Decimal(15, 2)
  total              Decimal             @default(0) @db.Decimal(15, 2)
  paidAmount         Decimal             @default(0) @map("paid_amount") @db.Decimal(15, 2)
  balance            Decimal             @default(0) @db.Decimal(15, 2)
  status             InvoiceStatus       @default(DRAFT)
  items              InvoiceItem[]
  paymentAllocations PaymentAllocation[]
  creditAllocations  CreditAllocation[]

  createdBy  User?      @relation("InvoiceCreator", fields: [createdById], references: [id])
  updatedBy  User?      @relation("InvoiceUpdater", fields: [updatedById], references: [id])
  customer   Customer   @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])

  @@map("invoices")
}

model InvoiceItem {
  id          String    @id @default(uuid()) @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  isArchived  Boolean   @default(false) @map("is_archived")
  archivedAt  DateTime? @map("archived_at")

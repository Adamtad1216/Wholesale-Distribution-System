generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Region {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  code        String      @unique
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdById String?     @map("created_by_id") @db.Uuid
  updatedById String?     @map("updated_by_id") @db.Uuid
  branches    Branch[]
  companies   Company[]
  createdBy   User?       @relation("RegionCreator", fields: [createdById], references: [id])
  updatedBy   User?       @relation("RegionUpdater", fields: [updatedById], references: [id])
  warehouses  Warehouse[]

  @@map("regions")
}

model Person {
  id                   String                @id @default(uuid()) @db.Uuid
  createdById          String?               @map("created_by_id") @db.Uuid
  updatedById          String?               @map("updated_by_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  isArchived           Boolean               @default(false) @map("is_archived")
  archivedAt           DateTime?             @map("archived_at")
  firstName            String                @map("first_name")
  middleName           String?               @map("middle_name")
  lastName             String                @map("last_name")
  phone                String?
  email                String?               @unique
  address              String?
  status               String                @default("ACTIVE")
  customers            Customer[]            @relation("PersonCustomer")
  employee             Employee?
  organizationContacts OrganizationContact[]
  createdBy            User?                 @relation("PersonCreator", fields: [createdById], references: [id])
  updatedBy            User?                 @relation("PersonUpdater", fields: [updatedById], references: [id])
  suppliers            Supplier[]            @relation("PersonSupplier")
  user                 User?

  @@map("persons")
}

model User {
  id                                                                     String                     @id @default(uuid()) @db.Uuid
  createdById                                                            String?                    @map("created_by_id") @db.Uuid
  updatedById                                                            String?                    @map("updated_by_id") @db.Uuid
  createdAt                                                              DateTime                   @default(now()) @map("created_at")
  updatedAt                                                              DateTime                   @updatedAt @map("updated_at")
  isArchived                                                             Boolean                    @default(false) @map("is_archived")
  archivedAt                                                             DateTime?                  @map("archived_at")
  personId                                                               String                     @unique @map("person_id") @db.Uuid
  username                                                               String?                    @unique
  passwordHash                                                           String?                    @map("password_hash")
  accountStatus                                                          UserAccountStatus          @default(INVITED) @map("account_status")
  isActive                                                               Boolean                    @default(false) @map("is_active")
  lastLoginAt                                                            DateTime?                  @map("last_login_at")
  failedLoginAttempts                                                    Int                        @default(0) @map("failed_login_attempts")
  lockedUntil                                                            DateTime?                  @map("locked_until")
  refreshTokenHash                                                       String?                    @map("refresh_token_hash")
  refreshTokenExpiresAt                                                  DateTime?                  @map("refresh_token_expires_at")
  resetTokenHash                                                         String?                    @map("reset_token_hash")
  resetTokenExpires                                                      DateTime?                  @map("reset_token_expires")
  invitationTokenHash                                                    String?                    @unique @map("invitation_token_hash")
  invitationTokenExpiresAt                                               DateTime?                  @map("invitation_token_expires_at")
  invitationAcceptedAt                                                   DateTime?                  @map("invitation_accepted_at")
  createdAiQueries                                                       AiQuery[]                  @relation("AiQueryCreator")
  updatedAiQueries                                                       AiQuery[]                  @relation("AiQueryUpdater")
  aiQueries                                                              AiQuery[]
  createdAiRecommendationSources                                         AiRecommendationSource[]   @relation("AiRecommendationSourceCreator")
  updatedAiRecommendationSources                                         AiRecommendationSource[]   @relation("AiRecommendationSourceUpdater")
  createdAiRecommendations                                               AiRecommendation[]         @relation("AiRecommendationCreator")
  updatedAiRecommendations                                               AiRecommendation[]         @relation("AiRecommendationUpdater")
  createdAuditLogs                                                       AuditLog[]                 @relation("AuditLogCreator")
  updatedAuditLogs                                                       AuditLog[]                 @relation("AuditLogUpdater")
  auditLogs                                                              AuditLog[]
  createdBranches                                                        Branch[]                   @relation("BranchCreator")
  updatedBranches                                                        Branch[]                   @relation("BranchUpdater")
  createdBrands                                                          Brand[]                    @relation("BrandCreator")
  updatedBrands                                                          Brand[]                    @relation("BrandUpdater")
  createdCategories                                                      Category[]                 @relation("CategoryCreator")
  updatedCategories                                                      Category[]                 @relation("CategoryUpdater")
  createdCompanies                                                       Company[]                  @relation("CompanyCreator")
  updatedCompanies                                                       Company[]                  @relation("CompanyUpdater")
  createdCredits                                                         Credit[]                   @relation("CreditCreator")
  updatedCredits                                                         Credit[]                   @relation("CreditUpdater")
  createdCustomerAddresses                                               CustomerAddress[]          @relation("CustomerAddressCreator")
  updatedCustomerAddresses                                               CustomerAddress[]          @relation("CustomerAddressUpdater")
  createdCustomers                                                       Customer[]                 @relation("CustomerCreator")
  updatedCustomers                                                       Customer[]                 @relation("CustomerUpdater")
  createdDeliveries                                                      Delivery[]                 @relation("DeliveryCreator")
  scheduledDeliveries                                                    Delivery[]                 @relation("DeliveryScheduler")
  updatedDeliveries                                                      Delivery[]                 @relation("DeliveryUpdater")
  createdDeliveryItems                                                   DeliveryItem[]             @relation("DeliveryItemCreator")
  updatedDeliveryItems                                                   DeliveryItem[]             @relation("DeliveryItemUpdater")
  createdDeliveryProofs                                                  DeliveryProof[]            @relation("DeliveryProofCreator")
  updatedDeliveryProofs                                                  DeliveryProof[]            @relation("DeliveryProofUpdater")
  createdDiscountRules                                                   DiscountRule[]             @relation("DiscountRuleCreator")
  updatedDiscountRules                                                   DiscountRule[]             @relation("DiscountRuleUpdater")
  createdEmployees                                                       Employee[]                 @relation("EmployeeCreator")
  updatedEmployees                                                       Employee[]                 @relation("EmployeeUpdater")
  createdGoodsReceiptItems                                               GoodsReceiptItem[]         @relation("GoodsReceiptItemCreator")
  updatedGoodsReceiptItems                                               GoodsReceiptItem[]         @relation("GoodsReceiptItemUpdater")
  createdGoodsReceipts                                                   GoodsReceipt[]             @relation("GoodsReceiptCreator")
  receivedGoodsReceipts                                                  GoodsReceipt[]
  updatedGoodsReceipts                                                   GoodsReceipt[]             @relation("GoodsReceiptUpdater")
  createdInvoiceItems                                                    InvoiceItem[]              @relation("InvoiceItemCreator")
  updatedInvoiceItems                                                    InvoiceItem[]              @relation("InvoiceItemUpdater")
  createdInvoices                                                        Invoice[]                  @relation("InvoiceCreator")
  updatedInvoices                                                        Invoice[]                  @relation("InvoiceUpdater")
  createdJobSpecifications                                               JobSpecification[]         @relation("JobSpecificationCreator")
  updatedJobSpecifications                                               JobSpecification[]         @relation("JobSpecificationUpdater")
  createdNotifications                                                   Notification[]             @relation("NotificationCreator")
  updatedNotifications                                                   Notification[]             @relation("NotificationUpdater")
  notifications                                                          Notification[]
  createdOrganizationContacts                                            OrganizationContact[]      @relation("OrganizationContactCreator")
  updatedOrganizationContacts                                            OrganizationContact[]      @relation("OrganizationContactUpdater")
  createdOrganizations                                                   Organization[]             @relation("OrganizationCreator")
  updatedOrganizations                                                   Organization[]             @relation("OrganizationUpdater")
  createdPaymentAllocations                                              PaymentAllocation[]        @relation("PaymentAllocationCreator")
  updatedPaymentAllocations                                              PaymentAllocation[]        @relation("PaymentAllocationUpdater")
  createdPaymentTerms                                                    PaymentTerms[]             @relation("PaymentTermsCreator")
  updatedPaymentTerms                                                    PaymentTerms[]             @relation("PaymentTermsUpdater")
  createdPayments                                                        Payment[]                  @relation("PaymentCreator")
  receivedPayments                                                       Payment[]
  updatedPayments                                                        Payment[]                  @relation("PaymentUpdater")
  createdPermissions                                                     Permission[]               @relation("PermissionCreator")
  updatedPermissions                                                     Permission[]               @relation("PermissionUpdater")
  createdPersons                                                         Person[]                   @relation("PersonCreator")
  updatedPersons                                                         Person[]                   @relation("PersonUpdater")
  createdPriceTiers                                                      PriceTier[]                @relation("PriceTierCreator")
  updatedPriceTiers                                                      PriceTier[]                @relation("PriceTierUpdater")
  createdProductImages                                                   ProductImage[]             @relation("ProductImageCreator")
  updatedProductImages                                                   ProductImage[]             @relation("ProductImageUpdater")
  createdProducts                                                        Product[]                  @relation("ProductCreator")
  updatedProducts                                                        Product[]                  @relation("ProductUpdater")
  createdPurchaseOrderItems                                              PurchaseOrderItem[]        @relation("PurchaseOrderItemCreator")
  updatedPurchaseOrderItems                                              PurchaseOrderItem[]        @relation("PurchaseOrderItemUpdater")
  approvedPurchaseOrders                                                 PurchaseOrder[]            @relation("PurchaseApprover")
  createdPurchaseOrders                                                  PurchaseOrder[]            @relation("PurchaseOrderCreator")
  orderedPurchaseOrders                                                  PurchaseOrder[]            @relation("PurchaseOrderer")
  updatedPurchaseOrders                                                  PurchaseOrder[]            @relation("PurchaseOrderUpdater")
  createdPurchaseReturnItems                                             PurchaseReturnItem[]       @relation("PurchaseReturnItemCreator")
  updatedPurchaseReturnItems                                             PurchaseReturnItem[]       @relation("PurchaseReturnItemUpdater")
  createdPurchaseReturns                                                 PurchaseReturn[]           @relation("PurchaseReturnCreator")
  updatedPurchaseReturns                                                 PurchaseReturn[]           @relation("PurchaseReturnUpdater")
  createdQuotations                                                      Quotation[]                @relation("QuotationCreator")
  updatedQuotations                                                      Quotation[]                @relation("QuotationUpdater")
  createdRefunds                                                         Refund[]                   @relation("RefundCreator")
  processedRefunds                                                       Refund[]
  updatedRefunds                                                         Refund[]                   @relation("RefundUpdater")
  createdRegions                                                         Region[]                   @relation("RegionCreator")
  updatedRegions                                                         Region[]                   @relation("RegionUpdater")
  createdRolePermissions                                                 RolePermission[]           @relation("RolePermissionCreator")
  updatedRolePermissions                                                 RolePermission[]           @relation("RolePermissionUpdater")
  createdRoles                                                           Role[]                     @relation("RoleCreator")
  updatedRoles                                                           Role[]                     @relation("RoleUpdater")
  createdSalesOrderItems                                                 SalesOrderItem[]           @relation("SalesOrderItemCreator")
  updatedSalesOrderItems                                                 SalesOrderItem[]           @relation("SalesOrderItemUpdater")
  createdSalesOrderQuotationItems                                        SalesOrderQuotationItem[]  @relation("SalesOrderQuotationItemCreator")
  updatedSalesOrderQuotationItems                                        SalesOrderQuotationItem[]  @relation("SalesOrderQuotationItemUpdater")
  salesOrderStatusChanges                                                SalesOrderStatusHistory[]  @relation("SalesOrderStatusChanger")
  approvedSalesOrders                                                    SalesOrder[]               @relation("SalesOrderApprover")
  createdSalesOrders                                                     SalesOrder[]               @relation("SalesOrderCreator")
  updatedSalesOrders                                                     SalesOrder[]               @relation("SalesOrderUpdater")
  createdSalesQuotas                                                     SalesQuota[]               @relation("SalesQuotaCreator")
  updatedSalesQuotas                                                     SalesQuota[]               @relation("SalesQuotaUpdater")
  createdSalesRequestItems                                               SalesRequestItem[]         @relation("SalesRequestItemCreator")
  updatedSalesRequestItems                                               SalesRequestItem[]         @relation("SalesRequestItemUpdater")
  createdSalesRequests                                                   SalesRequest[]             @relation("SalesRequestCreator")
  updatedSalesRequests                                                   SalesRequest[]             @relation("SalesRequestUpdater")
  createdSalesReturnItems                                                SalesReturnItem[]          @relation("SalesReturnItemCreator")
  updatedSalesReturnItems                                                SalesReturnItem[]          @relation("SalesReturnItemUpdater")
  createdSalesReturns                                                    SalesReturn[]              @relation("SalesReturnCreator")
  updatedSalesReturns                                                    SalesReturn[]              @relation("SalesReturnUpdater")
  createdStockAdjustmentItems                                            StockAdjustmentItem[]      @relation("StockAdjustmentItemCreator")
  updatedStockAdjustmentItems                                            StockAdjustmentItem[]      @relation("StockAdjustmentItemUpdater")
  approvedStockAdjustments                                               StockAdjustment[]          @relation("AdjustmentApprover")
  createdStockAdjustments                                                StockAdjustment[]          @relation("StockAdjustmentCreator")
  updatedStockAdjustments                                                StockAdjustment[]          @relation("StockAdjustmentUpdater")
  createdStockReservations                                               StockReservation[]         @relation("StockReservationCreator")
  updatedStockReservations                                               StockReservation[]         @relation("StockReservationUpdater")
  createdStockTransfers                                                  WarehouseStockTransfer[]   @relation("WarehouseStockTransferCreator")
  updatedStockTransfers                                                  WarehouseStockTransfer[]   @relation("WarehouseStockTransferUpdater")
  createdSupplierInvoices                                                SupplierInvoice[]          @relation("SupplierInvoiceCreator")
  updatedSupplierInvoices                                                SupplierInvoice[]          @relation("SupplierInvoiceUpdater")
  createdSuppliers                                                       Supplier[]                 @relation("SupplierCreator")
  updatedSuppliers                                                       Supplier[]                 @relation("SupplierUpdater")
  createdUnits                                                           Unit[]                     @relation("UnitCreator")
  updatedUnits                                                           Unit[]                     @relation("UnitUpdater")
  createdUserRoles                                                       UserRole[]                 @relation("UserRoleCreator")
  updatedUserRoles                                                       UserRole[]                 @relation("UserRoleUpdater")
  userRoles                                                              UserRole[]
  createdBy                                                              User?                      @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers                                                           User[]                     @relation("UserCreator")
  person                                                                 Person                     @relation(fields: [personId], references: [id])
  updatedBy                                                              User?                      @relation("UserUpdater", fields: [updatedById], references: [id])
  updatedUsers                                                           User[]                     @relation("UserUpdater")
  createdVehicles                                                        Vehicle[]                  @relation("VehicleCreator")
  updatedVehicles                                                        Vehicle[]                  @relation("VehicleUpdater")
  createdWarehouseSellingPrices                                          WarehouseSellingPrice[]    @relation("WarehouseSellingPriceCreator")
  updatedWarehouseSellingPrices                                          WarehouseSellingPrice[]    @relation("WarehouseSellingPriceUpdater")
  createdWarehouseStocks                                                 WarehouseStock[]           @relation("WarehouseStockCreator")
  updatedWarehouseStocks                                                 WarehouseStock[]           @relation("WarehouseStockUpdater")
  createdWarehouses                                                      Warehouse[]                @relation("WarehouseCreator")
  updatedWarehouses                                                      Warehouse[]                @relation("WarehouseUpdater")

  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  createdById     String?          @map("created_by_id") @db.Uuid
  updatedById     String?          @map("updated_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  isArchived      Boolean          @default(false) @map("is_archived")
  archivedAt      DateTime?        @map("archived_at")
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  createdBy       User?            @relation("RoleCreator", fields: [createdById], references: [id])
  updatedBy       User?            @relation("RoleUpdater", fields: [updatedById], references: [id])
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  createdById     String?          @map("created_by_id") @db.Uuid
  updatedById     String?          @map("updated_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  isArchived      Boolean          @default(false) @map("is_archived")
  archivedAt      DateTime?        @map("archived_at")
  name            String           @unique
  module          String
  action          String
  description     String?
  createdBy       User?            @relation("PermissionCreator", fields: [createdById], references: [id])
  updatedBy       User?            @relation("PermissionUpdater", fields: [updatedById], references: [id])
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  isArchived  Boolean   @default(false) @map("is_archived")
  archivedAt  DateTime? @map("archived_at")
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  createdBy   User?     @relation("UserRoleCreator", fields: [createdById], references: [id])
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  updatedBy   User?     @relation("UserRoleUpdater", fields: [updatedById], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  createdById  String?    @map("created_by_id") @db.Uuid
  updatedById  String?    @map("updated_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  isArchived   Boolean    @default(false) @map("is_archived")
  archivedAt   DateTime?  @map("archived_at")
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdBy    User?      @relation("RolePermissionCreator", fields: [createdById], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  updatedBy    User?      @relation("RolePermissionUpdater", fields: [updatedById], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model JobSpecification {
  id          String     @id @default(uuid()) @db.Uuid
  createdById String?    @map("created_by_id") @db.Uuid
  updatedById String?    @map("updated_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  isArchived  Boolean    @default(false) @map("is_archived")
  archivedAt  DateTime?  @map("archived_at")
  code        String     @unique
  title       String     @unique
  description String?
  department  String?
  status      String     @default("ACTIVE")
  employees   Employee[]
  createdBy   User?      @relation("JobSpecificationCreator", fields: [createdById], references: [id])
  updatedBy   User?      @relation("JobSpecificationUpdater", fields: [updatedById], references: [id])

  @@map("job_specifications")
}

model Employee {
  id                  String           @id @default(uuid()) @db.Uuid
  createdById         String?          @map("created_by_id") @db.Uuid
  updatedById         String?          @map("updated_by_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  isArchived          Boolean          @default(false) @map("is_archived")
  archivedAt          DateTime?        @map("archived_at")
  personId            String           @unique @map("person_id") @db.Uuid
  employeeCode        String           @unique @map("employee_code")
  hireDate            DateTime         @map("hire_date")
  department          String?
  jobSpecificationId  String           @map("job_specification_id") @db.Uuid
  status              String           @default("ACTIVE")
  commissionRate      Decimal?         @map("commission_rate") @db.Decimal(5, 2)
  salesTerritory      String?          @map("sales_territory")
  driverLicenseNumber String?          @map("driver_license_number")
  driverLicenseExpiry DateTime?        @map("driver_license_expiry")
  branchId            String?          @map("branch_id") @db.Uuid
  isAvailableForSales Boolean          @default(true) @map("is_available_for_sales")
  managedBranches     Branch[]         @relation("ManagedBranches")
  assignedCustomers   Customer[]       @relation("AssignedSalesRep")
  deliveries          Delivery[]
  branch              Branch?          @relation("EmployeeBranch", fields: [branchId], references: [id])
  createdBy           User?            @relation("EmployeeCreator", fields: [createdById], references: [id])
  jobSpecification    JobSpecification @relation(fields: [jobSpecificationId], references: [id])
  person              Person           @relation(fields: [personId], references: [id])
  updatedBy           User?            @relation("EmployeeUpdater", fields: [updatedById], references: [id])
  quotations          Quotation[]
  salesOrders         SalesOrder[]
  salesRequests       SalesRequest[]
  managedWarehouses   Warehouse[]      @relation("ManagedWarehouses")

  @@map("employees")
}

model Company {
  id                    String    @id @default(uuid()) @db.Uuid
  createdById           String?   @map("created_by_id") @db.Uuid
  updatedById           String?   @map("updated_by_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  isArchived            Boolean   @default(false) @map("is_archived")
  archivedAt            DateTime? @map("archived_at")
  name                  String
  legalName             String?   @map("legal_name")
  tradeLicenseNumber    String?   @unique @map("trade_license_number")
  tinNumber             String?   @unique @map("tin_number")
  vatRegistrationNumber String?   @unique @map("vat_registration_number")
  isVatRegistered       Boolean   @default(false) @map("is_vat_registered")
  phone                 String?
  alternatePhone        String?   @map("alternate_phone")
  email                 String?
  website               String?
  logoUrl               String?   @map("logo_url")
  regionId              String    @map("region_id") @db.Uuid
  city                  String?
  subCity               String?   @map("sub_city")
  woreda                String?
  kebele                String?
  houseNumber           String?   @map("house_number")
  landmark              String?
  status                String    @default("ACTIVE")
  branches              Branch[]
  createdBy             User?     @relation("CompanyCreator", fields: [createdById], references: [id])
  region                Region    @relation(fields: [regionId], references: [id])
  updatedBy             User?     @relation("CompanyUpdater", fields: [updatedById], references: [id])

  @@map("companies")
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  createdById  String?      @map("created_by_id") @db.Uuid
  updatedById  String?      @map("updated_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  isArchived   Boolean      @default(false) @map("is_archived")
  archivedAt   DateTime?    @map("archived_at")
  companyId    String       @map("company_id") @db.Uuid
  branchCode   String       @unique @map("branch_code")
  name         String
  isHeadOffice Boolean      @default(false) @map("is_head_office")
  managerId    String?      @map("manager_id") @db.Uuid
  phone        String?
  email        String?
  regionId     String       @map("region_id") @db.Uuid
  city         String?
  subCity      String?      @map("sub_city")
  woreda       String?
  kebele       String?
  houseNumber  String?      @map("house_number")
  landmark     String?
  status       String       @default("ACTIVE")
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("BranchCreator", fields: [createdById], references: [id])
  manager      Employee?    @relation("ManagedBranches", fields: [managerId], references: [id])
  region       Region       @relation(fields: [regionId], references: [id])
  updatedBy    User?        @relation("BranchUpdater", fields: [updatedById], references: [id])
  employees    Employee[]   @relation("EmployeeBranch")
  salesQuotas  SalesQuota[]
  warehouses   Warehouse[]

  @@map("branches")
}

model Warehouse {
  id                       String                     @id @default(uuid()) @db.Uuid
  createdById              String?                    @map("created_by_id") @db.Uuid
  updatedById              String?                    @map("updated_by_id") @db.Uuid
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  isArchived               Boolean                    @default(false) @map("is_archived")
  archivedAt               DateTime?                  @map("archived_at")
  code                     String                     @unique
  name                     String
  branchId                 String                     @map("branch_id") @db.Uuid
  location                 String?
  regionId                 String                     @map("region_id") @db.Uuid
  city                     String?
  subCity                  String?                    @map("sub_city")
  woreda                   String?
  kebele                   String?
  houseNumber              String?                    @map("house_number")
  managerId                String?                    @map("manager_id") @db.Uuid
  status                   String                     @default("ACTIVE")
  deliveries               Delivery[]
  goodsReceipts            GoodsReceipt[]
  priceTiers               PriceTier[]
  purchaseOrders           PurchaseOrder[]
  purchaseReturns          PurchaseReturn[]
  salesOrders              SalesOrder[]
  salesReturns             SalesReturn[]
  adjustments              StockAdjustment[]
  reservations             StockReservation[]
  warehouseSellingPrices   WarehouseSellingPrice[]
  stocks                   WarehouseStock[]
  transfersFrom            WarehouseStockTransfer[]   @relation("StockTransferFrom")
  transfersTo              WarehouseStockTransfer[]   @relation("StockTransferTo")
  branch                   Branch                     @relation(fields: [branchId], references: [id])
  createdBy                User?                      @relation("WarehouseCreator", fields: [createdById], references: [id])
  manager                  Employee?                  @relation("ManagedWarehouses", fields: [managerId], references: [id])
  region                   Region                     @relation(fields: [regionId], references: [id])
  updatedBy                User?                      @relation("WarehouseUpdater", fields: [updatedById], references: [id])

  @@map("warehouses")
}

model Organization {
  id                 String                @id @default(uuid()) @db.Uuid
  createdById        String?               @map("created_by_id") @db.Uuid
  updatedById        String?               @map("updated_by_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  isArchived         Boolean               @default(false) @map("is_archived")
  archivedAt         DateTime?             @map("archived_at")
  name               String
  registrationNumber String?               @map("registration_number")
  taxNumber          String?               @map("tax_number")

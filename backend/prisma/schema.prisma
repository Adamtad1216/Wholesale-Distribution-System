}

model Payment {
  id          String    @id @default(uuid()) @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  isArchived  Boolean   @default(false) @map("is_archived")
  archivedAt  DateTime? @map("archived_at")

  paymentNumber String  @unique @default(uuid()) @map("payment_number")
  customerId    String? @map("customer_id") @db.Uuid
  supplierId    String? @map("supplier_id") @db.Uuid
  orderId       String? @map("order_id") @db.Uuid

  amount         Decimal @db.Decimal(15, 2)
  currency       String  @default("ETB")
  status         String  @default("PENDING")
  method         String?
  timing         String?
  provider       String?
  transactionRef String? @unique @map("transaction_ref")

  paidAt        DateTime? @map("paid_at")
  processedById String?   @map("processed_by_id") @db.Uuid

  paymentType     PaymentType?   @map("payment_type")
  paymentMethod   PaymentMethod? @map("payment_method")
  paymentDate     DateTime?      @map("payment_date")
  referenceNumber String?        @map("reference_number")
  receivedBy      String?        @map("received_by") @db.Uuid

  allocations PaymentAllocation[]
  refunds     Refund[]
  attempts    PaymentAttempt[]
  proofs      PaymentProof[]
  webhooks    PaymentWebhook[]
  auditLogs   PaymentAuditLog[]

  createdBy   User?       @relation("PaymentCreator", fields: [createdById], references: [id])
  updatedBy   User?       @relation("PaymentUpdater", fields: [updatedById], references: [id])
  customer    Customer?   @relation(fields: [customerId], references: [id])
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  salesOrder  SalesOrder? @relation(fields: [orderId], references: [id])
  processedBy User?       @relation("PaymentProcessor", fields: [processedById], references: [id])
  receiver    User?       @relation(fields: [receivedBy], references: [id])

  @@map("payments")
}

model PaymentAllocation {
  id          String    @id @default(uuid()) @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
